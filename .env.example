# Copy this file to .env and put your real values in .env.
# .env is in .gitignore. This file holds only fake values.

# Neo4j (the database in docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j needs at least 8 characters.
NEO4J_PASSWORD=change-me-please

# Anthropic API key (needed from Step 3)
ANTHROPIC_API_KEY=sk-ant-your-key-here
